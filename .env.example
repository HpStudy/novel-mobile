VITE_APP_TITLE=小说阅读平台
VITE_API_PROXY_TARGET=http://localhost:3000

# Optional same-origin SMS sender endpoint, e.g. /auth/send-code.
# Leave empty until the backend provides an SMS sending route.
VITE_SMS_CODE_ENDPOINT=
# Phone login endpoint that verifies the received code and returns an access token.
VITE_PHONE_LOGIN_ENDPOINT=/auth/phone-login

# WeChat official-account OAuth configuration.
# Set the exact HTTPS callback URL registered in WeChat (usually this site's /login).
# The server endpoint must exchange the temporary WeChat OAuth code using server-side
# credentials and return { "accessToken": "...", "user": {} }. Never put app secrets here.
VITE_WECHAT_APP_ID=
VITE_WECHAT_REDIRECT_URI=
VITE_WECHAT_LOGIN_ENDPOINT=

# Optional hot-search API path. If omitted, hot words are derived from popular books.
VITE_SEARCH_HOT_ENDPOINT=
# Optional comma-separated static hot words, taking precedence over the API.
VITE_SEARCH_HOT_WORDS=
